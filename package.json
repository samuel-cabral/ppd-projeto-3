{
  "name": "mom-contagem-palavras",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MOM com RabbitMQ: contagem paralela de palavras-chave (PPD Projeto 3, IFCE)",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "infra": "docker compose up -d",
    "build:web": "vite build",
    "cliente": "node --import tsx src/cliente/servidor.ts",
    "cliente:cli": "node --import tsx src/cliente/cli.ts",
    "contador": "node --import tsx src/contador/index.ts",
    "dashboard": "node --import tsx src/dashboard/servidor.ts",
    "gerar": "node scripts/gerar-arquivo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --import tsx scripts/e2e.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
